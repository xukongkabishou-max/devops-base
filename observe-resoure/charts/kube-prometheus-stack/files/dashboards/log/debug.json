{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$query\" [1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "targets": [
        {
          "expr": "{namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$query\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "numbers",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "type": "logs"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "query",
        "label": "Search Query",
        "type": "textbox"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": "loki",
        "query": "label_values(namespace)",
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": "loki",
        "query": "label_values({namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "container",
        "label": "container",
        "type": "query",
        "datasource": "loki",
        "query": "label_values({namespace=~\"$namespace\", pod=~\"$pod\"}, container)",
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "Filters",
        "type": "adhoc",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Loki Logs (Final - Stable)",
  "version": 1
}