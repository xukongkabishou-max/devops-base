---
loki:
  schemaConfig:
    configs:
      - from: 2024-04-01
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  ingester:
    chunk_encoding: snappy
    # # tracing 分布式链路追踪
  tracing:
    enabled: true
  querier:
    # Default is 4, if you have enough memory and CPU you can increase, reduce if OOMing
    max_concurrent: 4

# allow_structured_metadata ：
  # 作用：允许在日志流（log stream）的标签（labels）中使用 结构化元数据（structured metadata）。
# 背景：Loki 传统上只支持基于 键值对标签（labels） 来索引日志流（如 {job="api", instance="server1"}），但标签是高基数的，滥用会导致性能问题。
# 结构化元数据 是 Grafana Labs 在 Loki 较新版本（v2.7+）引入的特性，它允许你在 不增加标签基数 的前提下，附加额外的、非索引的元数据（例如 user_id="12345"、trace_id="abc"），这些元数据会随日志一起存储，但 不会用于日志流的标识（即不参与 label 哈希）。
# 启用后，客户端（如 Promtail 或 Grafana Agent）可以通过特定方式（如 __structured_metadata__ 字段）发送这类元数据。
# 优点：避免因高基数标签导致的“标签爆炸”，同时仍能保留关键上下文信息。

#  olume_enabled: true
#     作用：启用 日志体积（log volume）分析功能。
#     此功能允许 Loki 统计每个日志流在指定时间范围内的日志行数（volume）。
#     主要用于：
#     在 Grafana 中使用 “Log volume”可视化（条形图显示各流的日志量）。
#     帮助用户快速识别 日志量突增的来源（如某个服务突然输出大量错误日志）。
#     后端需要支持（Loki 2.5+），且通常由 querier 组件在查询时额外计算或从索引中提取。
#     此功能会带来轻微的性能开销（因为要聚合计数），所以默认可能关闭。

# limits_config:
#   allow_structured_metadata: true
#   olume_enabled: true

  rulerConfig:
    storage:
      type: local
      local:
        directory: /tmp/loki/rules
    rule_path: /tmp/loki/scratch
    alertmanager_url: http://kube-prom-stack-alertmanager.observe:9093
    ring:
      kvstore:
        store: inmemory
    enable_api: true
    enable_alertmanager_v2: true

#gateway:
#  ingress:
#    enabled: true
#    hosts:
#      - host: FIXME
#        paths:
#          - path: /
#            pathType: Prefix

deploymentMode: Distributed

ingester:
  replicas: 3

#   # zoneAwareReplication.enabled: true（默认值通常是 true，取决于部署方式）
# 表示 Loki 在写入日志数据时，会尝试将 副本（replicas） 分布在 不同的故障域（如 AWS 的可用区、K8s 的 topology zones） 中，以提高容灾能力。
# zoneAwareReplication:
#    enabled: false
querier:
  replicas: 3
  maxUnavailable: 2
queryFrontend:
  replicas: 2
  maxUnavailable: 1
queryScheduler:
  replicas: 2
distributor:
  replicas: 3
  maxUnavailable: 2
compactor:
  replicas: 1
indexGateway:
  replicas: 2
  maxUnavailable: 1

# optional experimental components
bloomPlanner:
  replicas: 0
bloomBuilder:
  replicas: 0
bloomGateway:
  replicas: 0

# Enable minio for storage
minio:
  enabled: true

# Zero out replica counts of other deployment modes
backend:
  replicas: 0
read:
  replicas: 0
write:
  replicas: 0

singleBinary:
  replicas: 0
